{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "metrica-auth",
    "Audience": "metrica-api"
  },
  "ReverseProxy": {
    "Routes": {
      "login": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/login", "Methods": ["POST"] }
      },
      "register": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/register", "Methods": ["POST"] }
      },
      "upload": {
        "ClusterId": "control",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/cargas", "Methods": ["POST"] }
      },
      "status": {
        "ClusterId": "control",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/cargas/{identifier:guid}", "Methods": ["GET"] }
      },
      "auth-openapi": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/openapi/{**remainder}", "Methods": ["GET"] },
        "Transforms": [{ "PathRemovePrefix": "/auth" }, { "RequestHeaderOriginalHost": "true" }]
      },
      "control-openapi": {
        "ClusterId": "control",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/control/openapi/{**remainder}", "Methods": ["GET"] },
        "Transforms": [{ "PathRemovePrefix": "/control" }, { "RequestHeaderOriginalHost": "true" }]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "auth": { "Address": "http://localhost:5081/" } }
      },
      "control": {
        "Destinations": { "control": { "Address": "http://localhost:5082/" } }
      }
    }
  }
}
